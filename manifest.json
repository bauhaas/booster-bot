{
  "manifest_version": 3,
  "name": "Records Master Auto Booster",
  "version": "1.1",
  "description": "Opens a booster on recordsmaster.com every few minutes and alerts on legendary draws.",
  "permissions": ["alarms", "scripting", "notifications", "storage", "tabs"],
  "host_permissions": ["https://recordsmaster.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_icon": "icon.png" },
  "icons": { "48": "icon.png" }
}
